{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "freedeepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeDeepseekAPI",
      "options": {
        "baseURL": "http://127.0.0.1:9655/v1",
        "apiKey": "local"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek-V4.1-Flash (FreeDeepseekAPI)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  }
}

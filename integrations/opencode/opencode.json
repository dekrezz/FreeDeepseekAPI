{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "freedeepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Flash",
      "options": {
        "baseURL": "http://127.0.0.1:9655/v1",
        "apiKey": "local"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek 4.1",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "deepseek-v4-flash-thinking": {
          "name": "DeepSeek 4.1",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "deepseek-v4-flash-search": {
          "name": "DeepSeek 4.1",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        },
        "deepseek-v4-flash-thinking-search": {
          "name": "DeepSeek 4.1",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 1048576,
            "output": 8192
          }
        }
      }
    }
  },
  "tools": {
    "websearch": false,
    "webfetch": false
  },
  "permission": {
    "websearch": "deny",
    "webfetch": "deny"
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  }
}
